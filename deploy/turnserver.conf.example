# Public TURN host template. This file does not create a public server.
# Replace public/private address and secret before starting coturn.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_TURN_SECRET_AS_APP_ENV
realm=turn.example.com
external-ip=REPLACE_WITH_PUBLIC_IP
min-port=49160
max-port=49200
no-cli
no-multicast-peers
no-loopback-peers
stale-nonce=600
# To enable turns: add a trusted certificate and private key:
# cert=/path/to/fullchain.pem
# pkey=/path/to/privkey.pem
